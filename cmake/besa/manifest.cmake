# --------------------------------------------------------------------------------------------------
# Record BESA semantic units and public option metadata.
#
# The generated JSON manifest describes discovered source units, their types,
# feature constraints and registered CMake cache options. Other BESA facilities
# and the cpdocs provider consume this shared description. Internal global
# properties accumulate records until project finalization writes the manifest.

include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/internal.cmake")

# --------------------------------------------------------------------------------------------------
# Public API
# --------------------------------------------------------------------------------------------------

# Register existing project cache variables for manifest/report metadata.
#   besa_register_options(GROUP <group> VARIABLES <variable>...)
function(besa_register_options)
  _besa_require_config_open("besa_register_options")
  cmake_parse_arguments(ARG "" "GROUP" "VARIABLES" ${ARGN})
  _besa_require_no_unparsed("besa_register_options" "${ARG_UNPARSED_ARGUMENTS}")
  if(NOT ARG_GROUP OR NOT ARG_VARIABLES)
    _besa_fatal("besa_register_options" "GROUP and VARIABLES are required")
  endif()
  foreach(_variable IN LISTS ARG_VARIABLES)
    get_property(_is_cache CACHE "${_variable}" PROPERTY TYPE SET)
    if(NOT _is_cache)
      _besa_fatal("besa_register_options" "'${_variable}' is not a CMake cache variable")
    endif()
    get_property(_existing GLOBAL PROPERTY "BESA_OPTION_GROUP_${_variable}")
    if(_existing)
      _besa_fatal("besa_register_options" "'${_variable}' already registered")
    endif()
    set_property(GLOBAL PROPERTY "BESA_OPTION_GROUP_${_variable}" "${ARG_GROUP}")
    set_property(GLOBAL APPEND PROPERTY BESA_REGISTERED_OPTIONS "${_variable}")
  endforeach()
endfunction()

# --------------------------------------------------------------------------------------------------
# Internal implementation
# --------------------------------------------------------------------------------------------------

function(_besa_json_escape INPUT OUTPUT_VARIABLE)
  set(_value "${INPUT}")
  string(REPLACE "\\" "\\\\" _value "${_value}")
  string(REPLACE "\"" "\\\"" _value "${_value}")
  string(REPLACE "\n" "\\n" _value "${_value}")
  string(REPLACE "\r" "\\r" _value "${_value}")
  string(REPLACE "\t" "\\t" _value "${_value}")
  set("${OUTPUT_VARIABLE}" "${_value}" PARENT_SCOPE)
endfunction()

function(_besa_json_string INPUT OUTPUT_VARIABLE)
  _besa_json_escape("${INPUT}" _escaped)
  set("${OUTPUT_VARIABLE}" "\"${_escaped}\"" PARENT_SCOPE)
endfunction()

function(_besa_json_array OUTPUT_VARIABLE)
  set(_body "")
  foreach(_value IN LISTS ARGN)
    _besa_json_string("${_value}" _quoted)
    if(NOT "${_body}" STREQUAL "")
      string(APPEND _body ", ")
    endif()
    string(APPEND _body "${_quoted}")
  endforeach()
  set("${OUTPUT_VARIABLE}" "[${_body}]" PARENT_SCOPE)
endfunction()

function(_besa_manifest_register_unit)
  cmake_parse_arguments(ARG "GENERATED" "ID;TYPE;ROOT;SOURCE_TYPE" "" ${ARGN})
  _besa_require_no_unparsed("_besa_manifest_register_unit" "${ARG_UNPARSED_ARGUMENTS}")
  foreach(_required ID TYPE ROOT)
    _besa_require_value("_besa_manifest_register_unit" "${_required}" "${ARG_${_required}}")
  endforeach()
  get_property(_count GLOBAL PROPERTY BESA_MANIFEST_UNIT_COUNT)
  if("${_count}" STREQUAL "")
    set(_count 0)
  endif()
  math(EXPR _next "${_count} + 1")
  set_property(GLOBAL PROPERTY BESA_MANIFEST_UNIT_COUNT "${_next}")
  foreach(_field IN ITEMS ID TYPE ROOT SOURCE_TYPE)
    set_property(GLOBAL PROPERTY "BESA_MANIFEST_UNIT_${_count}_${_field}" "${ARG_${_field}}")
  endforeach()
  if(ARG_GENERATED)
    set(_generated TRUE)
  else()
    set(_generated FALSE)
  endif()
  set_property(GLOBAL PROPERTY "BESA_MANIFEST_UNIT_${_count}_GENERATED" "${_generated}")
endfunction()

function(_besa_manifest_type_language TYPE OUTPUT_VARIABLE)
  if(TYPE STREQUAL "c" OR TYPE STREQUAL "cpp" OR TYPE STREQUAL "cuda"
      OR TYPE STREQUAL "hip" OR TYPE STREQUAL "fortran")
    set(_language "${TYPE}")
  else()
    set(_language "")
  endif()
  set("${OUTPUT_VARIABLE}" "${_language}" PARENT_SCOPE)
endfunction()

# The semantic language is what documentation presents to users. The parser language is an
# implementation detail: CUDA and HIP public headers are currently parsed with the C++ frontend.
function(_besa_manifest_parser_language TYPE OUTPUT_VARIABLE)
  if(TYPE STREQUAL "c")
    set(_language c)
  elseif(TYPE STREQUAL "cpp" OR TYPE STREQUAL "cuda" OR TYPE STREQUAL "hip")
    set(_language cpp)
  elseif(TYPE STREQUAL "fortran")
    set(_language fortran)
  else()
    set(_language "")
  endif()
  set("${OUTPUT_VARIABLE}" "${_language}" PARENT_SCOPE)
endfunction()

function(_besa_manifest_standard TYPE OUTPUT_VARIABLE)
  if(TYPE STREQUAL "c" AND DEFINED CMAKE_C_STANDARD AND NOT "${CMAKE_C_STANDARD}" STREQUAL "")
    set(_standard "c${CMAKE_C_STANDARD}")
  elseif(TYPE STREQUAL "cpp" AND DEFINED CMAKE_CXX_STANDARD AND NOT "${CMAKE_CXX_STANDARD}" STREQUAL "")
    set(_standard "c++${CMAKE_CXX_STANDARD}")
  elseif(TYPE STREQUAL "cuda" AND DEFINED CMAKE_CUDA_STANDARD AND NOT "${CMAKE_CUDA_STANDARD}" STREQUAL "")
    set(_standard "cuda${CMAKE_CUDA_STANDARD}")
  elseif(TYPE STREQUAL "hip" AND DEFINED CMAKE_HIP_STANDARD AND NOT "${CMAKE_HIP_STANDARD}" STREQUAL "")
    set(_standard "hip${CMAKE_HIP_STANDARD}")
  else()
    set(_standard "")
  endif()
  set("${OUTPUT_VARIABLE}" "${_standard}" PARENT_SCOPE)
endfunction()

function(_besa_manifest_unit_json INDEX OUTPUT_VARIABLE)
  foreach(_field IN ITEMS ID TYPE ROOT SOURCE_TYPE GENERATED)
    get_property(_${_field} GLOBAL PROPERTY "BESA_MANIFEST_UNIT_${INDEX}_${_field}")
  endforeach()
  _besa_json_string("${_ID}" _id_json)
  _besa_json_string("${_TYPE}" _type_json)
  _besa_manifest_type_language("${_TYPE}" _language)
  if(_language)
    _besa_json_string("${_language}" _language_json)
  else()
    set(_language_json null)
  endif()
  if(_GENERATED)
    set(_generated_json true)
  else()
    set(_generated_json false)
  endif()

  set(_headers)
  set(_sources)
  set(_modules)
  set(_executables)
  if(_TYPE STREQUAL "bin")
    file(GLOB _bin_sources LIST_DIRECTORIES FALSE CONFIGURE_DEPENDS "${_ROOT}/*")
    list(APPEND _sources ${_bin_sources})
    list(APPEND _executables ${_bin_sources})
  else()
    if(IS_DIRECTORY "${_ROOT}/include" OR _GENERATED)
      list(APPEND _headers "${_ROOT}/include")
    endif()
    if(IS_DIRECTORY "${_ROOT}/lib" OR _GENERATED)
      list(APPEND _sources "${_ROOT}/lib")
    endif()
    if(_TYPE STREQUAL "fortran" AND (IS_DIRECTORY "${_ROOT}/mod" OR _GENERATED))
      list(APPEND _modules "${_ROOT}/mod")
    elseif(_TYPE STREQUAL "cpp" AND IS_DIRECTORY "${_ROOT}/module")
      list(APPEND _modules "${_ROOT}/module")
    endif()
  endif()
  _besa_json_array(_headers_json ${_headers})
  _besa_json_array(_sources_json ${_sources})
  _besa_json_array(_modules_json ${_modules})
  _besa_json_array(_executables_json ${_executables})

  # cpdocs currently consumes public header roots through `api`, while the explicit headers/sources
  # fields make the BESA manifest self-describing and leave room for more language backends.
  set(_api_objects)
  foreach(_header IN LISTS _headers)
    _besa_json_string("${_header}" _path_json)
    if(_GENERATED)
      list(APPEND _api_objects "{\"path\": ${_path_json}, \"generated\": true}")
    else()
      list(APPEND _api_objects "{\"path\": ${_path_json}}")
    endif()
  endforeach()
  if(_api_objects)
    string(JOIN ", " _api_json ${_api_objects})
  else()
    set(_api_json "")
  endif()

  set(_parse_parts)
  _besa_manifest_parser_language("${_TYPE}" _parser_language)
  if(_parser_language)
    _besa_json_string("${_parser_language}" _parser_language_json)
    list(APPEND _parse_parts "\"language\": ${_parser_language_json}")
  endif()
  _besa_manifest_standard("${_TYPE}" _standard)
  if(_standard)
    _besa_json_string("${_standard}" _standard_json)
    list(APPEND _parse_parts "\"standard\": ${_standard_json}")
  endif()
  if(EXISTS "${PROJECT_BINARY_DIR}/compile_commands.json")
    _besa_json_string("${PROJECT_BINARY_DIR}/compile_commands.json" _compile_json)
    list(APPEND _parse_parts "\"compile-database\": ${_compile_json}")
  endif()
  if(_parse_parts)
    string(JOIN ", " _parse_json ${_parse_parts})
  else()
    set(_parse_json "")
  endif()

  if(_SOURCE_TYPE)
    _besa_json_string("${_SOURCE_TYPE}" _source_type_json)
  else()
    set(_source_type_json null)
  endif()
  set(_json
    "{\"id\": ${_id_json}, \"type\": ${_type_json}, \"language\": ${_language_json}, "
    "\"generated\": ${_generated_json}, \"source-type\": ${_source_type_json}, "
    "\"headers\": ${_headers_json}, \"sources\": ${_sources_json}, "
    "\"modules\": ${_modules_json}, \"executables\": ${_executables_json}, "
    "\"api\": [${_api_json}], \"parse\": {${_parse_json}}}"
  )
  string(JOIN "" _json ${_json})
  set("${OUTPUT_VARIABLE}" "${_json}" PARENT_SCOPE)
endfunction()

function(_besa_manifest_units_json OUTPUT_VARIABLE)
  get_property(_count GLOBAL PROPERTY BESA_MANIFEST_UNIT_COUNT)
  if("${_count}" STREQUAL "")
    set(_count 0)
  endif()
  set(_units)
  if(_count GREATER 0)
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE 0 ${_last})
      _besa_manifest_unit_json("${_index}" _unit)
      list(APPEND _units "${_unit}")
    endforeach()
  endif()
  if(_units)
    string(JOIN ",\n    " _json ${_units})
  else()
    set(_json "")
  endif()
  set("${OUTPUT_VARIABLE}" "${_json}" PARENT_SCOPE)
endfunction()

function(_besa_manifest_options_json OUTPUT_VARIABLE)
  get_property(_registered GLOBAL PROPERTY BESA_REGISTERED_OPTIONS)
  set(_result "")
  foreach(_name IN LISTS _registered)
    get_property(_group GLOBAL PROPERTY "BESA_OPTION_GROUP_${_name}")
    get_property(_type CACHE "${_name}" PROPERTY TYPE)
    get_property(_help CACHE "${_name}" PROPERTY HELPSTRING)
    get_property(_allowed CACHE "${_name}" PROPERTY STRINGS)
    get_property(_value CACHE "${_name}" PROPERTY VALUE)
    _besa_json_string("${_name}" _name_json)
    _besa_json_string("${_group}" _group_json)
    _besa_json_string("${_type}" _type_json)
    _besa_json_string("${_help}" _help_json)
    _besa_json_string("${_value}" _value_json)
    _besa_json_array(_allowed_json ${_allowed})
    if(NOT "${_result}" STREQUAL "")
      string(APPEND _result ",\n    ")
    endif()
    string(APPEND _result "{\"name\":${_name_json},\"group\":${_group_json},\"type\":${_type_json},\"value\":${_value_json},\"description\":${_help_json},\"allowed\":${_allowed_json}}")
  endforeach()
  set("${OUTPUT_VARIABLE}" "[\n    ${_result}\n  ]" PARENT_SCOPE)
endfunction()

function(_besa_manifest_feature_constraints_json OUTPUT_VARIABLE)
  get_property(_var GLOBAL PROPERTY BESA_FEATURE_VARIABLE)
  get_property(_declared GLOBAL PROPERTY BESA_DECLARED_FEATURES)
  get_property(_space GLOBAL PROPERTY BESA_PROJECT_FEATURE_SPACE)
  get_property(_conflicts GLOBAL PROPERTY BESA_FEATURE_CONFLICTS)
  _besa_json_string("${_var}" _var_json)
  _besa_json_string("${_space}" _space_json)
  _besa_json_array(_declared_json ${_declared})
  set(_pairs)
  foreach(_record IN LISTS _conflicts)
    string(REPLACE "|" ";" _pair "${_record}")
    _besa_json_array(_pair_json ${_pair})
    list(APPEND _pairs "${_pair_json}")
  endforeach()
  string(JOIN "," _pairs_json ${_pairs})
  set("${OUTPUT_VARIABLE}" "{\"variable\":${_var_json},\"available\":${_declared_json},\"explicit_space\":${_space_json},\"conflicts\":[${_pairs_json}]}" PARENT_SCOPE)
endfunction()

function(_besa_manifest_write OUTPUT_FILE)
  get_property(_enabled GLOBAL PROPERTY BESA_ENABLED_FEATURES)
  _besa_json_array(_features_json ${_enabled})
  _besa_json_string("${PROJECT_NAME}" _project_json)
  _besa_manifest_options_json(_options_json)
  _besa_manifest_feature_constraints_json(_feature_info_json)
  _besa_manifest_units_json(_units_json)
  get_filename_component(_directory "${OUTPUT_FILE}" DIRECTORY)
  file(MAKE_DIRECTORY "${_directory}")
  file(WRITE "${OUTPUT_FILE}"
    "{\n"
    "  \"besa-manifest\": 1,\n"
    "  \"project\": ${_project_json},\n"
    "  \"features\": ${_features_json},\n"
    "  \"feature_configuration\": ${_feature_info_json},\n"
    "  \"options\": ${_options_json},\n"
    "  \"units\": [\n    ${_units_json}\n  ]\n"
    "}\n"
  )
endfunction()

function(_besa_manifest_finalize)
  set(_manifest "${PROJECT_BINARY_DIR}/besa/manifest.json")
  _besa_manifest_write("${_manifest}")
  set(BESA_MANIFEST "${_manifest}" CACHE INTERNAL "BESA semantic project manifest")
endfunction()
