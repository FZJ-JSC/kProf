# --------------------------------------------------------------------------------------------------
# Generate installation/export metadata for BESA-managed targets.
#
# BESA records installable targets as they are declared, then generates CMake
# exports and package configuration at deferred project finalization. Public
# header sets and transitive dependencies must be preserved for downstream
# find_package() consumers. Targets marked INSTALL NO stay build-local.

include_guard(GLOBAL)
include(CMakePackageConfigHelpers)

# --------------------------------------------------------------------------------------------------
# Internal implementation
# --------------------------------------------------------------------------------------------------

function(_besa_generate_dependency_block OUTPUT_VARIABLE)
  get_property(_dependencies GLOBAL PROPERTY BESA_NORMAL_DEPENDENCIES)
  set(_block "include(CMakeFindDependencyMacro)\n")
  foreach(_record IN LISTS _dependencies)
    string(REPLACE "|" ";" _fields "${_record}")
    list(GET _fields 0 _name)
    list(GET _fields 1 _provider)
    list(GET _fields 2 _version)
    list(GET _fields 3 _components_csv)
    string(REPLACE "," ";" _components "${_components_csv}")

    if(_provider STREQUAL "CMAKE")
      set(_line "find_dependency(${_name}")
      if(_version)
        string(APPEND _line " ${_version}")
      endif()
      if(_components)
        string(REPLACE ";" " " _component_text "${_components}")
        string(APPEND _line " COMPONENTS ${_component_text}")
      endif()
      string(APPEND _line ")\n")
    else()
      _besa_normalize_name("${_name}" _pkg_key)
      set(_line
        "find_dependency(PkgConfig)\npkg_check_modules(BESA_PKG_${_pkg_key} REQUIRED IMPORTED_TARGET ${_name})\n"
      )
    endif()
    string(APPEND _block "${_line}")
  endforeach()
  set("${OUTPUT_VARIABLE}" "${_block}" PARENT_SCOPE)
endfunction()

function(_besa_package_finalize)
  get_property(_targets GLOBAL PROPERTY BESA_INSTALL_TARGETS)
  if(NOT _targets)
    return()
  endif()
  list(REMOVE_DUPLICATES _targets)

  include(GNUInstallDirs)
  foreach(_target IN LISTS _targets)
    get_target_property(_type "${_target}" TYPE)
    if(_type STREQUAL "EXECUTABLE")
      install(TARGETS "${_target}" EXPORT "${PROJECT_NAME}Targets" RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}")
    else()
      # INTERFACE file sets are installable too (notably for header-only libraries).
      get_target_property(_header_sets "${_target}" INTERFACE_HEADER_SETS)
      get_target_property(_module_sets "${_target}" INTERFACE_CXX_MODULE_SETS)
      set(_file_sets)
      foreach(_set IN LISTS _header_sets)
        list(APPEND _file_sets FILE_SET "${_set}" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}")
      endforeach()
      foreach(_set IN LISTS _module_sets)
        list(APPEND _file_sets FILE_SET "${_set}" DESTINATION "${CMAKE_INSTALL_DATADIR}/${PROJECT_NAME}/modules")
      endforeach()
      install(
        TARGETS "${_target}"
        EXPORT "${PROJECT_NAME}Targets"
        ${_file_sets}
        CXX_MODULES_BMI DESTINATION ""
        ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}"
        LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}"
        RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}"
      )
    endif()
  endforeach()

  set(_package_dir "${CMAKE_INSTALL_LIBDIR}/cmake/${PROJECT_NAME}")
  install(
    EXPORT "${PROJECT_NAME}Targets"
    FILE "${PROJECT_NAME}Targets.cmake"
    NAMESPACE "${PROJECT_NAME}::"
    DESTINATION "${_package_dir}"
    CXX_MODULES_DIRECTORY "modules"
  )

  # Native CMake 4.3 CPS export, using the same target export set as Config.cmake.
  install(
    PACKAGE_INFO "${PROJECT_NAME}"
    EXPORT "${PROJECT_NAME}Targets"
    VERSION "${PROJECT_VERSION}"
    DESTINATION "${CMAKE_INSTALL_LIBDIR}/cps/${PROJECT_NAME}"
    DEFAULT_TARGETS ${_targets}
    CXX_MODULES_DIRECTORY "modules"
  )

  _besa_generate_dependency_block(_dependencies)
  set(_generated_dir "${PROJECT_BINARY_DIR}/besa/package")
  file(MAKE_DIRECTORY "${_generated_dir}")
  set(_config "${_generated_dir}/${PROJECT_NAME}Config.cmake")
  # REUSE-IgnoreStart
  file(WRITE "${_config}"
    "# --------------------------------------------------------------------------------------------------\n"
    "# SPDX-License-Identifier: Apache-2.0\n"
    "# SPDX-FileCopyrightText: 2026 ${PROJECT_NAME} developers\n"
    "# --------------------------------------------------------------------------------------------------\n"
    "# Generated by BESA.\n"
    "${_dependencies}"
    "include(\"\${CMAKE_CURRENT_LIST_DIR}/${PROJECT_NAME}Targets.cmake\")\n"
    "set(${PROJECT_NAME}_VERSION_STRING \"${PROJECT_SEMVER}\")\n"
  )
  # REUSE-IgnoreEnd

  write_basic_package_version_file(
    "${_generated_dir}/${PROJECT_NAME}ConfigVersion.cmake"
    VERSION "${PROJECT_VERSION}"
    COMPATIBILITY SameMajorVersion
  )
  install(
    FILES
    "${_config}"
    "${_generated_dir}/${PROJECT_NAME}ConfigVersion.cmake"
    DESTINATION "${_package_dir}"
  )

  # Record what CMake actually installed, not a projection of declared targets. Exclude this
  # manifest itself from its own contents. DESTDIR is handled by CMake's install runtime.
  set(_manifest_script "${_generated_dir}/write-install-manifest.cmake")
  set(_manifest_destination "${CMAKE_INSTALL_DATADIR}/${PROJECT_NAME}/install-manifest.json")
  file(WRITE "${_manifest_script}" [=[
    set(_files "[]")
    set(_index 0)
    set(_installed "${CMAKE_INSTALL_MANIFEST_FILES}")
    list(REMOVE_DUPLICATES _installed)
    foreach(_file IN LISTS _installed)
      file(RELATIVE_PATH _relative "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}" "${_file}")
      if(_relative MATCHES "^\\.\\.")
        message(FATAL_ERROR "BESA install manifest: path outside prefix: ${_file}")
      endif()
      string(JSON _files SET "${_files}" "${_index}" "\"${_relative}\"")
      math(EXPR _index "${_index} + 1")
    endforeach()
    string(JSON _manifest SET "{}" schema "\"besa-installation\"")
    string(JSON _manifest SET "${_manifest}" schema_version 1)
    string(JSON _manifest SET "${_manifest}" files "${_files}")
    set(_out "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@DESTINATION@")
    get_filename_component(_parent "${_out}" DIRECTORY)
    file(MAKE_DIRECTORY "${_parent}")
    file(WRITE "${_out}" "${_manifest}\n")
    ]=])
  file(READ "${_manifest_script}" _script_content)
  string(REPLACE "@DESTINATION@" "${_manifest_destination}" _script_content "${_script_content}")
  file(WRITE "${_manifest_script}" "${_script_content}")
  # install(CODE), unlike install(SCRIPT), has the CMAKE_INSTALL_MANIFEST_FILES list from
  # preceding install commands in the same install scope.
  install(CODE "include([[${_manifest_script}]])")
endfunction()
